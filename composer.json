{
    "name": "ajility/pest5-tia-test",
    "description": "Experiment repository for Pest 5 TIA in GitHub Actions",
    "type": "project",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
